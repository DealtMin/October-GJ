  name: "\u0423\u0447\u0435\u0431\u043D\u0438\u043A \u043F\u043E \u0442\u0443\u043B\u044C\u043F\u0430\u043C"
  description: "\u041A\u043D\u0438\u0433\u0438 \u043E \u0442\u043E\u043C, \u043A\u0430\u043A
    \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u0441\u0432\u043E\u044E \u0442\u0443\u043B\u044C\u043F\u0443.
    \u041C\u043D\u043E\u0433\u0438\u0435 \u0436\u0434\u0443\u0442 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u043A\u0438
    \u043E\u0442 \u0441\u0432\u043E\u0438\u0445 \u0442\u0443\u043B\u044C\u043F, \u043D\u043E
    \u043D\u0435 \u0432\u0441\u0435 \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u0441 \u0442\u0435\u043C, \u0447\u0442\u043E\u0431\u044B \u0441\u0430\u043C\u0438\u043C
    \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0441\u0432\u043E\u044E
    \u0442\u0443\u043B\u044C\u043F\u0443\u2026 \u0417\u0440\u044F. \u041E\u0442 \u044D\u0442\u043E\u0433\u043E
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430 \u043D\u0430\u0434\u043E \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044C\u0441\u044F."
  isEatable: 1
